{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and financial preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authentication UID of the user",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 500
        },
        "primaryCurrency": {
          "type": "string",
          "description": "User chosen primary currency",
          "enum": ["KRW", "USD", "EUR", "PKR"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of user registration",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of profile update",
          "maxLength": 64
        }
      },
      "required": ["userId", "email", "primaryCurrency", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "User financial pocket, card, or wallet",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the pocket",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Name of the account/pocket",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": ["checking", "savings", "cash", "credit"]
        },
        "currency": {
          "type": "string",
          "enum": ["KRW", "USD", "EUR", "PKR"]
        },
        "balance": {
          "type": "number",
          "description": "Opening/base balance in pocket currency"
        },
        "creditLimit": {
          "type": "number",
          "description": "Optional credit limit for credit card accounts"
        },
        "institution": {
          "type": "string",
          "maxLength": 120
        },
        "accountNumber": {
          "type": "string",
          "maxLength": 60
        },
        "bankCode": {
          "type": "string",
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "maxLength": 32
        },
        "isArchived": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "name", "type", "currency", "balance", "institution", "icon", "color"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income, expense, or transfer log entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense", "transfer"]
        },
        "amount": {
          "type": "number",
          "description": "Transaction amount in source currency"
        },
        "toAmount": {
          "type": "number",
          "description": "Destination received amount for cross-currency transfers"
        },
        "currency": {
          "type": "string",
          "enum": ["KRW", "USD", "EUR", "PKR"]
        },
        "date": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "categoryId": {
          "type": "string",
          "maxLength": 128
        },
        "accountId": {
          "type": "string",
          "maxLength": 128
        },
        "toAccountId": {
          "type": "string",
          "maxLength": 128
        },
        "merchant": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "receiptItems": {
          "type": "array",
          "description": "Itemized receipt line items (bounded <= 100)"
        },
        "isCharity": {
          "type": "boolean"
        },
        "charityPledgeId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "type", "amount", "currency", "date", "categoryId", "accountId", "createdAt", "updatedAt"]
    },
    "CharityPledge": {
      "title": "CharityPledge",
      "description": "User charity, Zakat, or Sadaqah pledge commitment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Pledge ID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "cause": {
          "type": "string",
          "maxLength": 120
        },
        "pledgedAmount": {
          "type": "number"
        },
        "fulfilledAmount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["KRW", "USD", "EUR", "PKR"]
        },
        "dueDate": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "partially_fulfilled", "fulfilled"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "cause", "pledgedAmount", "fulfilledAmount", "currency", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with display name and currency preferences"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Financial pockets and accounts belonging to the user"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Income, expense, and transfer records for the user"
    },
    "/users/{userId}/charity_pledges/{pledgeId}": {
      "schema": "CharityPledge",
      "description": "Charity, Zakat, and Sadaqah pledges belonging to the user"
    }
  }
}
